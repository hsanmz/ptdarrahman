{
  "name": "ptdarrahman-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "seed": "cd apps/api && python3 -m scripts.seed",
    "seed:cp": "cd apps/api && python3 -m scripts.seed_companyprofile",
    "seed:hero": "cd apps/api && python3 -m scripts.seed_hero"
  },
  "devDependencies": {
    "turbo": "^2.1.2",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32",
        "linux"
      ],
      "cpu": [
        "x64"
      ]
    }
  },
  "packageManager": "pnpm@9.10.0"
}
